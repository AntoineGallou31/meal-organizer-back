    { "label": "sachet de levure chimique", "match": "^levure chimique", "unit_weights": { "sachet": 11 } },

    { "label": "aubergine", "match": "^aubergine (crue|cuite)", "unit_weights": { "unite": 250 } },
    { "label": "poireau", "match": "^poireau (cru|cuit|bouilli)", "unit_weights": { "unite": 150 } },
    { "label": "concombre", "match": "^concombre chair et peau", "unit_weights": { "unite": 300 } },
    { "label": "patate douce", "match": "^patate douce (crue|cuite)$", "unit_weights": { "unite": 200 } },
