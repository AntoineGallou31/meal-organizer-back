    { "label": "tranche de saumon fumé", "match": "^saumon fume", "unit_weights": { "tranche": 25 } },
    { "label": "tranche de bacon", "match": "^(filet de bacon|poitrine de porc)", "unit_weights": { "tranche": 15 } },
    { "label": "poignée de feuilles (roquette, épinards, mâche...)", "match": "^(roquette crue|epinard cru|epinard jeunes pousses|mache crue|mesclun|salade ou chicoree|salade sucrine|laitue (crue|romaine|iceberg)|cresson)", "unit_weights": { "poignee": 30 } },
    { "label": "poignée de fruits secs ou graines", "match": "^(amande|noisette|noix|pignon de pin|cacahuete|sesame|tournesol|courge graine|raisin sec)", "unit_weights": { "poignee": 30 } },
    { "label": "noix ou noisette à l'unité", "match": "^(noix cerneau|noisette)", "unit_weights": { "unite": 5 } },
    { "label": "olive", "match": "^olive", "unit_weights": { "unite": 4 } },
    { "label": "tomate séchée", "match": "^tomate sechee", "unit_weights": { "unite": 6 } },
    { "label": "branche de céleri", "match": "^celeri branche", "unit_weights": { "brin": 40, "unite": 40 } },
    { "label": "figue", "match": "^figue crue", "unit_weights": { "unite": 50 } },
    { "label": "abricot", "match": "^abricot denoyaute cru", "unit_weights": { "unite": 45 } },
    { "label": "pêche", "match": "^peche (chair|blanche|jaune)", "unit_weights": { "unite": 150 } },
    { "label": "chou (rouge, blanc, fleur)", "match": "^chou (rouge|blanc|fleur)", "unit_weights": { "unite": 800 } },
    { "label": "brocoli", "match": "^brocoli", "unit_weights": { "unite": 400 } },
    { "label": "courge butternut", "match": "^courge butternut", "unit_weights": { "unite": 1000 } },
    { "label": "potimarron", "match": "^potimarron", "unit_weights": { "unite": 1000 } },
    { "label": "crevette", "match": "^crevette", "unit_weights": { "unite": 10 } },
