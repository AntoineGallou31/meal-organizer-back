    { "label": "vin", "match": "^vin (blanc|rouge|rose|aliment moyen|cuisine)", "density": 0.99 },
    { "label": "miel", "match": "^miel$", "density": 1.42 },
    { "label": "farine", "match": "^farine", "density": 0.55 },
    { "label": "sucre", "match": "^sucre (blanc|roux)$", "density": 0.85 },
    { "label": "maïzena et fécules", "match": "^(amidon de mais|fecule)", "density": 0.6 }
