    { "label": "courgette", "match": "^courgette chair et peau", "unit_weights": { "unite": 200 } },
    { "label": "poivron", "match": "^poivron", "unit_weights": { "unite": 150 } },
    { "label": "citron jaune", "match": "^citron chair", "unit_weights": { "unite": 100 } },
    { "label": "citron vert", "match": "^citron vert ou lime chair", "unit_weights": { "unite": 60 } },
    { "label": "pomme", "match": "^pomme chair", "unit_weights": { "unite": 150 } },
    { "label": "banane", "match": "^banane chair sans peau crue", "unit_weights": { "unite": 120 } },
    { "label": "avocat", "match": "^avocat chair", "unit_weights": { "unite": 150 } },
