{
  "description": "Poids unitaires (g par unité) et densités (g/ml) appliqués par importCiqual.js. « match » est une regex testée sur le nom Ciqual normalisé (minuscules, sans accents, ponctuation → espaces). Si plusieurs entrées correspondent à un aliment, leurs poids unitaires sont fusionnés.",
  "units": [
    { "label": "œuf entier", "match": "^oeuf (cru|dur|poche|a la coque)$", "unit_weights": { "unite": 55 } },
    { "label": "jaune d'œuf", "match": "^oeuf jaune jaune d oeuf (cru|cuit)$", "unit_weights": { "unite": 18 } },
    { "label": "blanc d'œuf", "match": "^oeuf blanc blanc d oeuf (cru|cuit)$", "unit_weights": { "unite": 33 } },
    { "label": "oignon", "match": "^oignon (cru|cuit|surgele|rouge|jaune|blanc)", "unit_weights": { "unite": 100 } },
    { "label": "échalote", "match": "^echalote (crue|cuite|sautee)", "unit_weights": { "unite": 25 } },
    { "label": "ail", "match": "^ail (cru|roti|grille)", "unit_weights": { "gousse": 5 } },
    { "label": "tomate", "match": "^tomate (sans precision|ronde|grappe|allongee|marmande|cotelee|noire|entiere|chair et peau)", "unit_weights": { "unite": 120 } },
    { "label": "tomate cerise", "match": "^tomate cerise", "unit_weights": { "unite": 15 } },
    { "label": "carotte", "match": "^carotte (crue|cuite|bouillie)", "unit_weights": { "unite": 100 } },
